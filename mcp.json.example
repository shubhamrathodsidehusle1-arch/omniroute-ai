{
  "mcpServers": {
    "ruflo": {
      "command": "npx",
      "args": ["-y", "ruflo@latest", "mcp", "start"],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "50",
        "CLAUDE_FLOW_MEMORY_BACKEND": "agentdb"
      },
      "autoStart": false
    },
    "ruv-swarm": {
      "command": "npx",
      "args": ["-y", "ruv-swarm", "mcp", "start"],
      "env": { "npm_config_update_notifier": "false" },
      "optional": true
    },
    "pexels": {
      "command": "npx",
      "args": ["-y", "mcp-pexels"],
      "env": { "PEXELS_API_KEY": "your-pexels-api-key" }
    },
    "flow-nexus": {
      "command": "npx",
      "args": ["-y", "flow-nexus@latest", "mcp", "start"],
      "env": { "npm_config_update_notifier": "false" },
      "optional": true,
      "requiresAuth": true
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "n8n-mcp": {
      "type": "http",
      "url": "http://n8n:5678/mcp-server/http",
      "headers": {
        "Authorization": "Bearer your-n8n-mcp-token"
      }
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "your-21st-dev-api-key"
      }
    }
  }
}
