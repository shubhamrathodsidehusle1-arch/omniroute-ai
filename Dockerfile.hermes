FROM python:3.11-alpine
RUN apk add --no-cache git curl jq && \
    curl -fsSL https://astral.sh/uv/install.sh | sh && \
    export PATH="$HOME/.local/bin:$PATH" && \
    git clone https://github.com/NousResearch/hermes-agent.git /hermes-agent && \
    git -C /hermes-agent checkout 9712b8f0cc7112ced7d38ce789103c7090508c3d && \
    cd /hermes-agent && uv venv && uv sync && \
    apk add --no-cache npm && \
    cd /hermes-agent/web && npm install -q && npm run build 2>/dev/null; true

COPY entrypoint-hermes.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /hermes-agent
ENTRYPOINT ["/entrypoint.sh"]