# syntax=docker/dockerfile:1
#
# Conway Automaton — wired to use OmniRoute as its LLM provider and
# billing/earn-or-die source instead of the Conway control plane.
# The build clones the upstream repo, applies automaton.patch (which
# enables plain-HTTP access to the OmniRoute gateway, switches auth to
# Bearer, and maps the credits balance to the automaton key's OmniRoute
# usage budget), and compiles a standalone runtime.

FROM node:22-bookworm-slim AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY automaton.patch /tmp/automaton.patch
RUN git clone https://github.com/Conway-Research/automaton.git /src \
    && git -C /src checkout 871c53e39b9180920c775759ddc38789699d69ea \
    && git -C /src apply /tmp/automaton.patch && rm /tmp/automaton.patch
RUN corepack enable && CI=true pnpm install --frozen-lockfile
RUN CI=true pnpm build && CI=true pnpm prune --prod

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl jq \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src /app
COPY entrypoint-automaton.sh /usr/local/bin/entrypoint-automaton.sh
RUN chmod +x /usr/local/bin/entrypoint-automaton.sh \
    && chmod +x /app/dist/index.js \
    && ln -sf /app/dist/index.js /usr/local/bin/automaton
ENV HOME=/data
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/entrypoint-automaton.sh"]
